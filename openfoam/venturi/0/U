/*--------------------------------*- C++ -*----------------------------------*\
| OpenFOAM ESI v2606 -- 2D Venturi passage, Re = U*H/nu = 100                      |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);
boundaryField
{
    inlet
    {
        // fully developed plane Poiseuille profile, mean velocity 1, height H = 1 (y in [-0.5, 0.5])
        type            exprFixedValue;
        valueExpr       "vector(1.5*(1 - sqr(2*pos().y())), 0, 0)";
        value           uniform (0 0 0);
    }
    outlet       { type zeroGradient; }
    bottomWall   { type noSlip; }
    topWall      { type noSlip; }
    frontAndBack { type empty; }
}
