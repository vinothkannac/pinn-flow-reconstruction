dtValue  0.0025;    // 0.16/nCells  ->  Courant ~ U*dt/dx = 0.16 < 0.5
tEnd     100;       // end time (convective time units L/U)
tWrite   5;         // write interval (time units); purgeWrite keeps the last 3
